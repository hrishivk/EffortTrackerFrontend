# Used automatically by `vite build` (production mode).
# Committed on purpose so a deploy cannot accidentally ship a localhost bundle.

# TEMPORARY — the certificate on rxtracker.icu expired. Put this back to
# https:// the moment it is renewed.
#
# Two things have to be true for this to work at all, and neither is a
# frontend change:
#
#   1. The site itself must also be served over http://. A page loaded over
#      https cannot call an http API — the browser blocks it as mixed content
#      before the request leaves, and no frontend setting turns that off.
#   2. The session cookie must not be `Secure`, or it will not be sent over
#      http and every request comes back 401. If it is `SameSite=None` it is
#      required to be `Secure`, so the backend has to change both together.
#
# Every service here sends `withCredentials: true`, so on plain http the
# session cookie crosses the network in clear text. Treat this as a
# stop-gap measured in hours, not a configuration to settle on.
VITE_API_BASE_URL=http://rxtracker.icu
